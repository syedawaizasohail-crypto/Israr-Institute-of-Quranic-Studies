        };

        function setDays(days) {
            currentDays = days;
            document.querySelectorAll('.day-btn').forEach(btn => {
                btn.classList.remove('bg-ruby-600', 'text-white', 'border-ruby-50');
                btn.classList.add('bg-darkness-800', 'text-white');
            });
            event.currentTarget.classList.remove('bg-darkness-800');
            event.currentTarget.classList.add('bg-ruby-600', 'text-white');
            calculateFee();
        }

        function setDuration(dur) {
            currentDuration = dur;
            document.querySelectorAll('.dur-btn').forEach(btn => {
                btn.classList.remove('bg-ruby-600', 'text-white');
                btn.classList.add('bg-darkness-800', 'text-white');
            });
            event.currentTarget.classList.remove('bg-darkness-800');
            event.currentTarget.classList.add('bg-ruby-600', 'text-white');
            calculateFee();
        }

        function calculateFee() {
            const region = document.getElementById('regionSelect').value;
            const data = feeTable[region];
            const price = data[currentDays][currentDuration];
            const display = document.getElementById('feeDisplay');
            display.innerText = `${data.currency}${price.toLocaleString()} ${data.suffix}`;
        }
